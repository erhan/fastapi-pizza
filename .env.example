# Copy to .env and tweak. Every value below is the default, so the app also runs without it.
DATABASE_URL=sqlite+aiosqlite:///./pizza.db

# The "chef's key" that protects POST/PATCH/DELETE. Demo value: change it before deploying!
API_KEY=demo-chef-key

CREATE_TABLES_ON_STARTUP=true
SEED_ON_STARTUP=true
