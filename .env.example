# Copy to .env and tweak.

# SQLite needs no setup. For PostgreSQL: `docker compose up -d`, then use the second line.
DATABASE_URL=sqlite+aiosqlite:///./pizza.db
# DATABASE_URL=postgresql://pizza:pizza@localhost:5432/pizza

# The "chef's key" that protects the menu (POST/PATCH/DELETE). Demo value: change it before deploying!
API_KEY=demo-chef-key

# Signs the customers' login tokens (JWT). Demo value: use a long random string in production.
SECRET_KEY=demo-secret-key-change-me-0123456789abcdef
ACCESS_TOKEN_EXPIRE_MINUTES=60

# With Alembic in charge (`uv run alembic upgrade head`) set the first one to false.
CREATE_TABLES_ON_STARTUP=true
SEED_ON_STARTUP=true
